{
  "name": "dsh-settings-bridge",
  "version": "0.1.0",
  "description": "通用第三方插件设置桥：让任意已注册的 settings 命名空间都能出现在 Web UI 设置页，并提供 JSON 配置卡片。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
